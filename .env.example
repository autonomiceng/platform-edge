# Complete Caddy image reference for local experiments; empty uses the validated Compose default.
PE_CADDY_IMAGE=
# Choose local (HTTP and self-signed HTTPS), public (trusted HTTPS for your domain), or proxy (another gateway handles HTTPS).
PE_ACCESS_MODE=local
# Public domain. Fixed hosts: root, litellm., langfuse., s3., backplane., grafana.
PE_PUBLIC_DOMAIN=localhost
# Browser URL protocol; leave empty for http locally, https with public certificates or another gateway.
PE_SCHEME=
# Interface Caddy publishes on. 0.0.0.0 exposes the edge to the network.
PE_BIND_HOST=127.0.0.1
# Published HTTP port.
PE_HTTP_PORT=80
# Published HTTPS port.
PE_HTTPS_PORT=443
# External Docker network shared with the stacks on this host.
PE_PLATFORM_NETWORK=platform
# IPv4 subnet the first bootstrap creates the shared network with; every bootstrap validates it.
PE_PLATFORM_SUBNET=172.30.0.0/24
# Dynamic allocation range inside the subnet; addresses outside it are reserved for fixed peers.
PE_PLATFORM_IP_RANGE=172.30.0.128/25
# Fixed Edge address inside the subnet and outside the dynamic range; siblings trust this /32.
PE_EDGE_IP=172.30.0.2
# Certificate issuer: empty selects internal in local mode and acme in public mode; files uses PE_TLS_DIR.
PE_TLS_ISSUER=
# Optional contact email for ACME certificate registration and renewal.
PE_ACME_EMAIL=
# ACME directory URL (https) of a private or alternative CA; empty uses Let's Encrypt.
PE_ACME_CA=
# PEM file with the private ACME server's CA, mounted for Caddy and trusted by the readiness probe.
PE_ACME_CA_ROOT=
# External account binding key identifier, when the ACME CA requires one.
PE_ACME_EAB_KEY_ID=
# External account binding HMAC key; set together with the key identifier.
PE_ACME_EAB_HMAC=
# Directory with tls.crt and tls.key for PE_TLS_ISSUER=files, mounted read-only at /certs.
PE_TLS_DIR=
# PEM file the readiness probe trusts for HTTPS when the issuing CA is not in the system store.
PE_TLS_CA=
# Durable volume namespace, independent of the Compose project name.
PE_VOLUME_PREFIX=platform-edge
# Checkpoint repository; encrypt and replicate off-host before relying on it.
PE_BACKUP_DIR=./backups
# Complete Checkpoint sets to retain after a successful capture.
PE_BACKUP_KEEP=7
# Metrics socket peers; add only scraper /32s (IPv6 /128s), never the Docker bridge gateway or subnet.
PE_METRICS_ALLOW="127.0.0.0/8 ::1"
# Exact trusted ingress peer IPs (or /32, /128), never whole Docker or Tailnet ranges.
PE_TRUSTED_PROXIES=
# Tailscale auth key for bootstrap --tailscale: reusable, non-ephemeral, tagged. Secret; never commit it.
PE_TS_AUTHKEY=
# Tag every Tailscale node advertises; must be one of the key's tags. Empty or absent omits the flag and the key's tags apply.
PE_TS_TAG=tag:platform
# Tailscale nodes to start, one per routed hostname; drop the nodes of stacks you do not run.
PE_TS_APPS=console,litellm,langfuse,s3,rustfs,backplane,grafana
# Hostname label of the console's Tailscale node; empty means platform.
PE_ROOT_HOST=
# The tailnet's MagicDNS domain (<tailnet>.ts.net); bootstrap --tailscale records it after enrollment.
PE_TAILNET_DOMAIN=
