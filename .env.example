# Complete Caddy image reference for local experiments; empty uses the validated Compose default.
PE_CADDY_IMAGE=
# Choose local (HTTP and self-signed HTTPS), public (trusted HTTPS for your domain), or proxy (another gateway handles HTTPS).
PE_ACCESS_MODE=local
# Public domain. Fixed hosts: root, litellm., langfuse., s3., backplane., grafana.
PE_PUBLIC_DOMAIN=localhost
# Browser URL protocol; leave empty for http locally, https with public certificates or another gateway.
PE_SCHEME=
# Interface Caddy publishes on. 0.0.0.0 exposes the edge to the network.
PE_BIND_HOST=127.0.0.1
# Published HTTP port.
PE_HTTP_PORT=80
# Published HTTPS port.
PE_HTTPS_PORT=443
# External Docker network shared with the stacks on this host.
PE_PLATFORM_NETWORK=platform
# IPv4 subnet the first bootstrap creates the shared network with; every bootstrap validates it.
PE_PLATFORM_SUBNET=172.30.0.0/24
# Dynamic allocation range inside the subnet; addresses outside it are reserved for fixed peers.
PE_PLATFORM_IP_RANGE=172.30.0.128/25
# Fixed Edge address inside the subnet and outside the dynamic range; siblings trust this /32.
PE_EDGE_IP=172.30.0.2
# Optional contact email for public certificate registration and renewal.
PE_ACME_EMAIL=
# Durable volume namespace, independent of the Compose project name.
PE_VOLUME_PREFIX=platform-edge
# Checkpoint repository; encrypt and replicate off-host before relying on it.
PE_BACKUP_DIR=./backups
# Complete Checkpoint sets to retain after a successful capture.
PE_BACKUP_KEEP=7
# Metrics socket peers; add only scraper /32s (IPv6 /128s), never the Docker bridge gateway or subnet.
PE_METRICS_ALLOW="127.0.0.0/8 ::1"
# Filled by the Tailscale setup helper; leave empty for direct access.
PE_TAILSCALE_HOST=
# Applications connected by the Tailscale setup command; comma-separated generated names.
PE_TAILSCALE_APPS=
# HTTPS port for the Tailscale landing page.
PE_TAILSCALE_PORT=443
# Tailscale HTTPS port for litellm; set by the setup helper.
PE_TAILSCALE_LITELLM_PORT=8443
# Tailscale HTTPS port for langfuse; set by the setup helper.
PE_TAILSCALE_LANGFUSE_PORT=8444
# Tailscale HTTPS port for s3; set by the setup helper.
PE_TAILSCALE_S3_PORT=8445
# Tailscale HTTPS port for gateway; set by the setup helper.
PE_TAILSCALE_GATEWAY_PORT=8446
# Tailscale HTTPS port for grafana; set by the setup helper.
PE_TAILSCALE_GRAFANA_PORT=8447
# Tailscale HTTPS port for backplane; set by the setup helper.
PE_TAILSCALE_BACKPLANE_PORT=8448
# Tailscale HTTPS port for the RustFS admin console; set by the setup helper.
PE_TAILSCALE_RUSTFS_PORT=8449
# Private Backplane RustFS console HTTPS port; published only when that console is enabled.
PE_TAILSCALE_BACKPLANE_RUSTFS_PORT=8450
# Private Observability RustFS console HTTPS port; published only when that console is enabled.
PE_TAILSCALE_OBSERVABILITY_RUSTFS_PORT=8451
# Exact trusted ingress peer IPs (or /32, /128), never whole Docker or Tailnet ranges.
# Tailscale setup records the host bridge gateway used by its loopback connection.
PE_TRUSTED_PROXIES=
