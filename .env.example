# Public domain. Fixed hosts: root, litellm., langfuse., s3., backplane., grafana.
PE_PUBLIC_DOMAIN=localhost
# http for Local Mode; https for Public Mode.
PE_SCHEME=http
# none for http; acme (public DNS) or internal (private CA) for https.
PE_TLS_ISSUER=none
# Interface Caddy publishes on. 0.0.0.0 exposes the edge to the network.
PE_BIND_HOST=127.0.0.1
# Published HTTP port.
PE_HTTP_PORT=80
# Published HTTPS port.
PE_HTTPS_PORT=443
# External Docker network shared with the stacks on this host.
PE_PLATFORM_NETWORK=platform
# ACME account email. Used only with PE_TLS_ISSUER=acme; empty uses the issuer default.
PE_ACME_EMAIL=
# Durable volume namespace, independent of the Compose project name.
PE_VOLUME_PREFIX=platform-edge
# Checkpoint repository; encrypt and replicate off-host before relying on it.
PE_BACKUP_DIR=./backups
# Complete Checkpoint sets to retain after a successful capture.
PE_BACKUP_KEEP=7
# Metrics socket peers; add only scraper /32s (IPv6 /128s), never the Docker bridge gateway or subnet.
PE_METRICS_ALLOW="127.0.0.0/8 ::1"
