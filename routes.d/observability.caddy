(observability-routes) {
	import access-log
	import access-headers-{$PE_ACCESS_MODE:local}
	reverse_proxy ob-gateway:80 {
		header_up Host {host}
		import forwarded-proto-{$PE_ACCESS_MODE:local}
	}
}
(observability-local) {
	http://grafana.{$PE_PUBLIC_DOMAIN} {
		import observability-routes
	}
	https://grafana.{$PE_PUBLIC_DOMAIN} {
		tls internal
		import observability-routes
	}
}
(observability-public) {
	https://grafana.{$PE_PUBLIC_DOMAIN} {
		import ca-acme
		import observability-routes
	}
}
(observability-proxy) {
	http://grafana.{$PE_PUBLIC_DOMAIN} {
		import observability-routes
	}
}
import observability-{$PE_ACCESS_MODE:local}
