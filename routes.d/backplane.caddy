(backplane-routes) {
	import access-log
	import access-headers-{$PE_ACCESS_MODE:local}
	@operator path_regexp (?i)^/+(health/+operations|metrics)\.*(/|$)
	respond @operator 404
	# The operator token unlocks readiness details only on the backplane's loopback port.
	@ready path_regexp (?i)^/+health/+ready\.*(/|$)
	request_header @ready -Authorization
	reverse_proxy bp-server:3000 {
		header_up Host {host}
		import forwarded-proto-{$PE_ACCESS_MODE:local}
	}
}
(backplane-local) {
	http://backplane.{$PE_PUBLIC_DOMAIN} {
		import backplane-routes
	}
	https://backplane.{$PE_PUBLIC_DOMAIN} {
		tls internal
		import backplane-routes
	}
}
(backplane-public) {
	https://backplane.{$PE_PUBLIC_DOMAIN} {
		import ca-acme
		import backplane-routes
	}
}
(backplane-proxy) {
	http://backplane.{$PE_PUBLIC_DOMAIN} {
		import backplane-routes
	}
}
import backplane-{$PE_ACCESS_MODE:local}
