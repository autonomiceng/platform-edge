(gateway-root-routes) {
	import access-log
	import access-headers-{$PE_ACCESS_MODE:local}
	handle /health {
		respond /health 200
	}
	import edge-metrics
	import stack-probes
	import console-config
	handle / {
		root * /srv/console
		header Cache-Control "no-cache"
		templates
		file_server
	}

	handle {
		reverse_proxy lg-gateway:80 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up Host {host}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}
	handle_errors {
		import status-errors
		import access-headers-{$PE_ACCESS_MODE:local}
		@probe expression `{http.request.orig_uri.path} in ["/health/gateway", "/health/backplane", "/health/observability", "/health/litellm", "/health/langfuse", "/health/s3", "/health/rustfs"]`
		handle @probe {
			header Cache-Control "no-store"
			respond "" {err.status_code}
		}
		handle {
			respond "Upstream unavailable" {err.status_code}
		}
	}
}
(gateway-root-local) {
	http://{$PE_PUBLIC_DOMAIN} {
		import gateway-root-routes
	}
	https://{$PE_PUBLIC_DOMAIN} {
		tls internal
		import gateway-root-routes
	}
}
(gateway-root-public) {
	https://{$PE_PUBLIC_DOMAIN} {
		import ca-acme
		import gateway-root-routes
	}
}
(gateway-root-proxy) {
	http://{$PE_PUBLIC_DOMAIN} {
		import gateway-root-routes
	}
}
import gateway-root-{$PE_ACCESS_MODE:local}

