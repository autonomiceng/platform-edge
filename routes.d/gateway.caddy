(gateway-root-routes) {
	import access-log
	import access-headers-{$PE_ACCESS_MODE:local}
	handle /health {
		respond /health 200
	}
	import edge-metrics
	import stack-probes
	import console-config
	handle / {
		root * /srv/console
		header Cache-Control "no-cache"
		templates
		file_server
	}

	handle {
		reverse_proxy lg-gateway:80 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up Host {host}
			import {args[0]}
		}
	}
	handle_errors {
		import status-errors
		import access-headers-{$PE_ACCESS_MODE:local}
		@probe expression `{http.request.orig_uri.path} in ["/health/gateway", "/health/backplane", "/health/observability", "/health/litellm", "/health/langfuse", "/health/s3", "/health/rustfs"]`
		handle @probe {
			header Cache-Control "no-store"
			respond "" {err.status_code}
		}
		handle {
			respond "Upstream unavailable" {err.status_code}
		}
	}
}
import site {$PE_PUBLIC_DOMAIN} gateway-root-routes
import tailnet-site {$PE_ROOT_HOST:platform} gateway-root-routes

(gateway-app-routes) {
	import access-log
	import access-headers-{$PE_ACCESS_MODE:local}
	reverse_proxy lg-gateway:80 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up Host {host}
		import {args[0]}
	}
}
import site litellm.{$PE_PUBLIC_DOMAIN} gateway-app-routes
import site langfuse.{$PE_PUBLIC_DOMAIN} gateway-app-routes
import site s3.{$PE_PUBLIC_DOMAIN} gateway-app-routes
import site rustfs.{$PE_PUBLIC_DOMAIN} gateway-app-routes
import tailnet-site litellm gateway-app-routes
import tailnet-site langfuse gateway-app-routes
import tailnet-site s3 gateway-app-routes
import tailnet-site rustfs gateway-app-routes
