(stack-probes) {
	# Same-origin probes for the fallback page. A missing alias becomes a 502.
	handle /health/gateway {
		header Cache-Control "no-store"
		rewrite * /
		reverse_proxy lg-gateway:80 {
			import probe-response
			header_up -Authorization
			header_up Host {$PE_PUBLIC_DOMAIN}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}
	handle /health/backplane {
		header Cache-Control "no-store"
		rewrite * /health/ready
		reverse_proxy bp-server:3000 {
			import probe-response
			header_up -Authorization
			header_up Host backplane.{$PE_PUBLIC_DOMAIN}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}
	handle /health/observability {
		header Cache-Control "no-store"
		rewrite * /health/grafana
		reverse_proxy ob-gateway:80 {
			import probe-response
			header_up -Authorization
			header_up Host {$PE_PUBLIC_DOMAIN}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}
	handle /health/litellm {
		header Cache-Control "no-store"
		rewrite * /health/litellm
		reverse_proxy lg-gateway:80 {
			import probe-response
			header_up -Authorization
			header_up Host {$PE_PUBLIC_DOMAIN}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}

	handle /health/langfuse {
		header Cache-Control "no-store"
		rewrite * /health/langfuse
		reverse_proxy lg-gateway:80 {
			import probe-response
			header_up -Authorization
			header_up Host {$PE_PUBLIC_DOMAIN}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}

	handle /health/s3 {
		header Cache-Control "no-store"
		rewrite * /health/rustfs
		reverse_proxy lg-gateway:80 {
			import probe-response
			header_up -Authorization
			header_up Host {$PE_PUBLIC_DOMAIN}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}
}

(gateway-root-routes) {
	import access-log
	import access-headers-{$PE_ACCESS_MODE:local}
	handle /health {
		respond /health 200
	}
	import edge-metrics
	import stack-probes
	import console-config

	handle {
		reverse_proxy lg-gateway:80 {
			header_up Host {host}
			import forwarded-proto-{$PE_ACCESS_MODE:local}
		}
	}
	handle_errors {
		import access-headers-{$PE_ACCESS_MODE:local}
		@probe expression `{http.request.orig_uri.path} in ["/health/gateway", "/health/backplane", "/health/observability", "/health/litellm", "/health/langfuse", "/health/s3"]`
		handle @probe {
			header Cache-Control "no-store"
			respond "" {err.status_code}
		}
		@console {
			expression `{http.request.orig_uri.path} == "/" && {err.status_code} == 502`
		}
		handle @console {
			root * /srv/console
			rewrite * /index.html
			templates
			file_server
		}
		handle {
			respond "Upstream unavailable" {err.status_code}
		}
	}
}
(gateway-root-local) {
	http://{$PE_PUBLIC_DOMAIN} {
		import gateway-root-routes
	}
	https://{$PE_PUBLIC_DOMAIN} {
		tls internal
		import gateway-root-routes
	}
}
(gateway-root-public) {
	https://{$PE_PUBLIC_DOMAIN} {
		import ca-acme
		import gateway-root-routes
	}
}
(gateway-root-proxy) {
	http://{$PE_PUBLIC_DOMAIN} {
		import gateway-root-routes
	}
}
import gateway-root-{$PE_ACCESS_MODE:local}

