(tailscale-apps) {
	@ts_rustfs expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_RUSTFS_PORT:8449}"`
	handle @ts_rustfs {
		reverse_proxy lg-gateway:80 {
			header_up X-Forwarded-Proto https
		}
	}
	@ts_litellm expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_LITELLM_PORT:8443}"`
	handle @ts_litellm {
		route {
			reverse_proxy lg-gateway:80 {
				# Preserve Host including its port for login origins and S3 signatures.
				header_up X-Forwarded-Proto https
			}
		}
	}
	@ts_langfuse expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_LANGFUSE_PORT:8444}"`
	handle @ts_langfuse {
		route {
			reverse_proxy lg-gateway:80 {
				# Preserve Host including its port for login origins and S3 signatures.
				header_up X-Forwarded-Proto https
			}
		}
	}
	@ts_s3 expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_S3_PORT:8445}"`
	handle @ts_s3 {
		route {
			reverse_proxy lg-gateway:80 {
				# Preserve Host including its port for login origins and S3 signatures.
				header_up X-Forwarded-Proto https
			}
		}
	}
	@ts_gateway expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_GATEWAY_PORT:8446}"`
	handle @ts_gateway {
		route {
			reverse_proxy lg-gateway:80 {
				# Preserve Host including its port for login origins and S3 signatures.
				header_up X-Forwarded-Proto https
			}
		}
	}
	@ts_grafana expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_GRAFANA_PORT:8447}"`
	handle @ts_grafana {
		route {
			reverse_proxy ob-gateway:80 {
				# Preserve Host including its port for login origins and S3 signatures.
				header_up X-Forwarded-Proto https
			}
		}
	}
	@ts_backplane expression `"{$PE_TAILSCALE_HOST}" != "" && {http.request.hostport} == "{$PE_TAILSCALE_HOST}:{$PE_TAILSCALE_BACKPLANE_PORT:8448}"`
	handle @ts_backplane {
		route {
			@operator path_regexp (?i)^/+(health/+operations|metrics)\.*(/|$)
			respond @operator 404
			@ready path_regexp (?i)^/+health/+ready\.*(/|$)
			request_header @ready -Authorization
			reverse_proxy bp-gateway:80 {
				# Preserve Host including its port for login origins and S3 signatures.
				header_up X-Forwarded-Proto https
			}
		}
	}
}
