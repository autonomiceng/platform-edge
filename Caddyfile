# Static config only: no Docker socket, no caddy-docker-proxy.
{
	admin localhost:2019
	metrics
	servers {
		trusted_proxies static {$PE_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
	skip_install_trust
	# IP clients omit SNI; Docker NAT hides the requested loopback address.
	default_sni 127.0.0.1
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}

# Issuer snippets, selected by PE_TLS_ISSUER; bootstrap validates the mode and issuer pair.
(tls-internal) {
	tls internal
}
# Empty email and dir mean Caddy's defaults (Let's Encrypt). Caddy refuses empty trusted_roots
# and eab arguments, so the overlays that supply them also select those snippets.
(tls-acme) {
	tls {
		issuer acme {
			email "{$PE_ACME_EMAIL}"
			dir "{$PE_ACME_CA}"
			import acme-trust-{$PE_ACME_TRUST:system}
			import acme-account-{$PE_ACME_ACCOUNT:none}
		}
	}
}
(acme-trust-system) {
}
(acme-trust-file) {
	trusted_roots /certs/acme-ca-root.crt
}
(acme-account-none) {
}
(acme-account-eab) {
	eab "{$PE_ACME_EAB_KEY_ID}" "{$PE_ACME_EAB_HMAC}"
}
# compose.files.yaml mounts PE_TLS_DIR read-only at /certs.
(tls-files) {
	tls /certs/tls.crt /certs/tls.key
}
# Retired alias for operator Route Files; removed in the next release.
(ca-acme) {
	import tls-acme
}

# One line per hostname in a Route File: `import site <host> <routes-snippet>` expands to the
# listeners of PE_ACCESS_MODE, with the selected issuer on the HTTPS listener. The routes snippet
# receives the forwarded-proto snippet to import inside its reverse_proxy as {args[0]}.
(site) {
	import site-{$PE_ACCESS_MODE:local} {args[0]} {args[1]}
}
(site-local) {
	http://{args[0]} {
		import {args[1]} forwarded-proto-local
	}
	https://{args[0]} {
		import tls-{$PE_TLS_ISSUER:internal}
		import {args[1]} forwarded-proto-local
	}
}
(site-public) {
	https://{args[0]} {
		import tls-{$PE_TLS_ISSUER:acme}
		import {args[1]} forwarded-proto-public
	}
}
(site-proxy) {
	http://{args[0]} {
		import {args[1]} forwarded-proto-proxy
	}
}

# Tailnet Origins (ADR-0004): `import tailnet-site <name> <routes-snippet>` serves
# http://<name>.<tailnet> only when compose.tailscale.yaml sets PE_TAILNET. The node terminates
# TLS and proxies plain HTTP over the Platform Network, so Edge sets the upstream scheme itself:
# HTTPS for peers in the dynamic range (the nodes), the request scheme for everyone else.
# No forwarded header is trusted. Every node reaches every Tailnet host: one authorization domain.
(tailnet-site) {
	import tailnet-site-{$PE_TAILNET:off} {args[0]} {args[1]}
}
(tailnet-site-off) {
}
(tailnet-site-on) {
	http://{args[0]}.{$PE_TAILNET_DOMAIN} {
		@node remote_ip {$PE_PLATFORM_IP_RANGE}
		vars tailnet_scheme {scheme}
		vars @node tailnet_scheme https
		import {args[1]} forwarded-proto-tailnet
	}
}

# The container liveness probe stays on HTTP; bootstrap verifies TLS separately.
(health-http) {
	:80 {
		import access-log
		respond /health 200
		respond 404
	}
}

(health-https) {
	import health-http
	http://{$PE_PUBLIC_DOMAIN}, http://127.0.0.1 {
		import access-log
		route {
			respond /health 200
			redir https://{host}{uri} 308
		}
	}
}

(headers-https) {
	header >Strict-Transport-Security "max-age=31536000"
}

# Import inside a reverse_proxy: expose status only, including upstream failures.
(probe-response) {
	handle_response {
		header -Content-Type
		header -Content-Length
		header Cache-Control "no-store"
		respond "" {rp.status_code}
	}
}

(access-log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}
(access-headers-local) {
}
(access-headers-public) {
	import headers-https
}
(access-headers-proxy) {
}

(health-public) {
	import health-https
}
(console-config) {
    @console-assets path /console/app.js /console/catalog.js /console/status.js /console/style.css /console/icons/*
    handle @console-assets {
        root * /srv/console
        uri strip_prefix /console
        header Cache-Control "no-cache"
        file_server
    }
	handle /edge-config.json {
		root * /srv/console
		rewrite * /config.json
		header Cache-Control "no-store"
		header Content-Type "application/json"
		templates {
			mime application/json
		}
		file_server
	}
}
(console-handlers) {
	import access-log
	route {
	import stack-probes
	import console-config
	handle /health {
		respond 200
	}
	handle / {
		root * /srv/console
		header Cache-Control "no-cache"
		templates
		file_server
	}
	handle {
		respond 404
	}
	}
	handle_errors {
		import status-errors
		@probe path /health/*
		handle @probe {
			header Cache-Control "no-store"
			respond "" {err.status_code}
		}
		respond "This application is not reachable. Return to Platform Edge to check its status." {err.status_code}
	}
}
(health-local) {
	:80 {
		import console-handlers
	}
	http://127.0.0.1 {
		import console-handlers
	}
	https://127.0.0.1 {
		tls internal
		import console-handlers
	}
}
(health-proxy) {
	:80 {
		import console-handlers
	}
}

(forwarded-proto-local) {
	header_up X-Forwarded-Proto {scheme}
}
(forwarded-proto-public) {
	header_up X-Forwarded-Proto {scheme}
}
(forwarded-proto-proxy) {
	# The operator configures the external origin; never trust arbitrary headers.
	header_up X-Forwarded-Proto {$PE_SCHEME}
}
(forwarded-proto-tailnet) {
	header_up X-Forwarded-Proto {vars.tailnet_scheme}
}

# Internal scraping uses the stable network alias instead of an application domain.
(edge-metrics) {
	handle /metrics* {
		@public not remote_ip {$PE_METRICS_ALLOW:127.0.0.0/8 ::1}
		route {
			respond @public 403
			metrics /metrics/caddy {
				disable_openmetrics
			}
			root * /config
			header Content-Type "text/plain; version=0.0.4"
			templates
			respond /metrics `{{httpInclude "/metrics/caddy"}}{{if fileExists "pe-certificate.prom"}}{{include "pe-certificate.prom"}}{{end}}`
			respond 404
		}
	}
}
http://pe-edge {
	import access-log
	import edge-metrics
	handle {
		respond 404
	}
}

import /etc/caddy/routes.d/*.caddy
import health-{$PE_ACCESS_MODE:local}
