# Static config only: no Docker socket, no caddy-docker-proxy.
{
	admin localhost:2019
	metrics
	servers {
		trusted_proxies static {$PE_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
	skip_install_trust
	# IP clients omit SNI; Docker NAT hides the requested loopback address.
	default_sni 127.0.0.1
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}

(ca-acme) {
	tls {
		issuer acme {
			email "{$PE_ACME_EMAIL}"
		}
	}
}

# The container liveness probe stays on HTTP; bootstrap verifies TLS separately.
(health-http) {
	:80 {
		import access-log
		respond /health 200
		respond 404
	}
}

(health-https) {
	import health-http
	http://{$PE_PUBLIC_DOMAIN}, http://127.0.0.1 {
		import access-log
		route {
			respond /health 200
			redir https://{host}{uri} 308
		}
	}
}

(headers-https) {
	header >Strict-Transport-Security "max-age=31536000"
}

# Import inside a reverse_proxy: expose status only, including upstream failures.
(probe-response) {
	handle_response {
		header -Content-Type
		header -Content-Length
		header Cache-Control "no-store"
		respond "" {rp.status_code}
	}
}

(access-log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp \?.* ?REDACTED
				resp_headers delete
			}
		}
	}
}
(access-headers-local) {
}
(access-headers-public) {
	import headers-https
}
(access-headers-proxy) {
}

(health-public) {
	import health-https
}
(console-config) {
    @console-assets path /console/app.js /console/catalog.js /console/status.js /console/style.css /console/icons/*
    handle @console-assets {
        root * /srv/console
        uri strip_prefix /console
        header Cache-Control "no-cache"
        file_server
    }
	handle /edge-config.json {
		root * /srv/console
		rewrite * /config.json
		header Cache-Control "no-store"
		header Content-Type "application/json"
		templates {
			mime application/json
		}
		file_server
	}
}
(console-handlers) {
	import access-log
	route {
	import tailscale-apps
	import stack-probes
	import console-config
	handle /health {
		respond 200
	}
	handle / {
		root * /srv/console
		header Cache-Control "no-cache"
		templates
		file_server
	}
	handle {
		respond 404
	}
	}
	handle_errors {
		import status-errors
		@probe path /health/*
		handle @probe {
			header Cache-Control "no-store"
			respond "" {err.status_code}
		}
		respond "This application is not reachable. Return to Platform Edge to check its status." {err.status_code}
	}
}
(health-local) {
	:80 {
		import console-handlers
	}
	http://127.0.0.1 {
		import console-handlers
	}
	https://127.0.0.1 {
		tls internal
		import console-handlers
	}
}
(health-proxy) {
	:80 {
		import console-handlers
	}
}

(forwarded-proto-local) {
	header_up X-Forwarded-Proto {scheme}
}
(forwarded-proto-public) {
	header_up X-Forwarded-Proto {scheme}
}
(forwarded-proto-proxy) {
	# The operator configures the external origin; never trust arbitrary headers.
	header_up X-Forwarded-Proto {$PE_SCHEME}
}

# Internal scraping uses the stable network alias instead of an application domain.
(edge-metrics) {
	handle /metrics* {
		@public not remote_ip {$PE_METRICS_ALLOW:127.0.0.0/8 ::1}
		route {
			respond @public 403
			metrics /metrics/caddy {
				disable_openmetrics
			}
			root * /config
			header Content-Type "text/plain; version=0.0.4"
			templates
			respond /metrics `{{httpInclude "/metrics/caddy"}}{{if fileExists "pe-certificate.prom"}}{{include "pe-certificate.prom"}}{{end}}`
			respond 404
		}
	}
}
http://pe-edge {
	import access-log
	import edge-metrics
	handle {
		respond 404
	}
}

import /etc/caddy/routes.d/*.caddy
import health-{$PE_ACCESS_MODE:local}
